{
  "manifest_version": 3,
  "name": "Kairós — Bienestar Digital",
  "version": "0.1.0",
  "description": "Tu copiloto de bienestar digital. Rastrea tu tiempo en la web.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-scroll.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-intervention.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Kairós"
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "http://localhost:3001/*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
